{
  "name": "based-markdown",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build:mac": "npm run build && electron-builder --mac dmg",
    "build": "node scripts/build.mjs",
    "prestart": "npm run build"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "linkedom": "^0.18.13"
  },
  "build": {
    "appId": "dev.based.markdown",
    "productName": "Based",
    "files": [
      "app/**/*",
      "src/**/*",
      "plugins/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    }
  }
}
